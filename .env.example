# Optional configuration for MusicVer.
# For source runs copy this to .env in the project root.
# For the packaged Windows app copy it to:
#   C:\Users\<you>\AppData\Roaming\MusicVer\.env
#
# Only the keys you need have to be set. Real environment variables take
# precedence over this file.

# JioSaavn API base (defaults to https://saavn.sumit.co/api)
# JIOSAAVN_API_BASE=https://saavn.sumit.co/api

# Optional YouTube Data API key (legacy integrations)
# YOUTUBE_API_KEY=

# Optional VidKraken API key
# VIDKRAKEN_API_KEY=

# Default music folder for a fresh install (otherwise ~/Music)
# MUSIC_FOLDER=C:\Users\<you>\Music
